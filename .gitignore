# Gradle build output
/build/

# Gradle wrapper - strategy:
# - gradle/wrapper/gradle-wrapper.jar is committed (52KB, needed for wrapper)
# - gradle/wrapper/gradle-wrapper.properties is committed (config file)
# - gradle/wrapper/dists/ is NOT committed but CAN be pre-cached locally
#   See GRADLE-BRIDGE-CHEATSHEET.md: Build Performance > Pre-Caching
/gradle/wrapper/dists/
/.gradle/

# Ant build output
/dist/
*.class
*.jar

# IDE files
/.idea/
*.iml
*.ipr
*.iws
/.vscode/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Misc
lib/*.jar
