```bash
# Cleanup function - always runs on exit
cleanup() {
    local exit_code=$?
    
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if [ $exit_code -eq 0 ]; then
        echo "✅ All tests passed!"
        if [ "$DOCKER_MODE" = "true" ]; then
            echo "Cleaning up Docker infrastructure..."
            cd "$INFRA_DIR"
            docker compose down -v 2>/dev/null || true
        fi
    else
        echo "❌ Tests failed (exit code: $exit_code)"
        if [ "$DOCKER_MODE" = "true" ]; then
            echo "Cleaning up Docker infrastructure..."
            cd "$INFRA_DIR"
            docker compose down -v 2>/dev/null || true
        fi
    fi
    
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    exit $exit_code
}

trap cleanup EXIT
```

**How it works:**
1. **`trap cleanup EXIT`** - Runs cleanup function when script exits (success or failure)
2. **Docker mode** - Removes containers and volumes: `docker compose down -v`
3. **Host mode** - No cleanup (containers stay running for manual testing)
4. **Shows exit status** - ✅ passed or ❌ failed

